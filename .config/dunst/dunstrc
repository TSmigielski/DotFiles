[global]
    monitor = 0
    font = FiraCode Nerd Font 10
    width = (250, 400)
    offset = 32x32
    frame_width = 1
    separator_color = auto
    idle_threshold = 200
    markup = yes
    format = "<b>%s</b>\n%b"
    alignment = center
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    icon_theme = "Nordzy-cyan-dark"
    enable_recursive_icon_lookup = true
    min_icon_size = 24

    background = "#2e3440dd"
    foreground = "#d8dee9"
    highlight = "#8fbcbb"


[urgency_low]
    frame_color = "#bec8da"

[urgency_normal]
    frame_color = "#5e81ac"

[urgency_critical]
    frame_color = "#c84141"
    timeout = 0


[slack]
    appname = "Slack"
    summary = "*"
    script = ~/Utilities/dunst-urgent-notification.sh
